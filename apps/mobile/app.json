{
  "expo": {
    "name": "ENNOIA",
    "owner": "jessecinnamonfir",
    "slug": "ennoia",
    "scheme": "ennoia",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ennoia.app",
      "associatedDomains": [
        "webcredentials:www.ennoia.live",
        "applinks:www.ennoia.live"
      ]
    },
    "android": {
      "package": "com.ennoia.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEFEFE"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "af8b6a80-3fd7-4b54-85cd-0f55190decba"
      }
    },
    "plugins": [
      "expo-video",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "ENNOIA lets you choose photos and videos to share in posts.",
          "cameraPermission": "ENNOIA uses your camera only when you choose to capture media."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/ennoia-mark.png",
          "backgroundColor": "#000000",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/ennoia-mark.png",
            "backgroundColor": "#000000",
            "imageWidth": 200,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@bacons/apple-targets",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "enableScreenShareService": true
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ]
  }
}