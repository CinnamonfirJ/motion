{
  "expo": {
    "name": "ENNOIA",
    "owner": "jessecinnamonfir",
    "slug": "ennoia",
    "scheme": "ennoia",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#FEFEFE",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ennoia.app"
    },
    "android": {
      "package": "com.ennoia.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEFEFE"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-video",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "ENNOIA lets you choose photos and videos to share in posts.",
          "cameraPermission": "ENNOIA uses your camera only when you choose to capture media."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FEFEFE",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@bacons/apple-targets",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "enableScreenShareService": true
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ]
  }
}
