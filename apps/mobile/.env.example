# ==================================================================
# ENNOIA — MOBILE environment (copy to apps/mobile/.env)
#
# Expo inlines every EXPO_PUBLIC_-prefixed var into the CLIENT BUNDLE. Only
# PUBLIC, non-secret values here — never an API secret or private key.
#
# NOTE: a phone/emulator cannot reach "localhost" (that's the device itself).
# Point these at this dev machine's LAN IP and restart: npx expo start --clear
# ==================================================================

# Backend REST + WebSocket (LAN IP, not localhost, for a real device).
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
EXPO_PUBLIC_WS_URL=ws://192.168.1.100:4000/ws

# --- Privy (public app identifiers only) ---
# NOTE: Privy passkeys + embedded wallets require a CUSTOM EXPO DEV BUILD — they
# do NOT run in Expo Go. In Expo Go the app uses the email/guest fallback.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_PRIVY_RELYING_PARTY=https://ennoia.app

# --- LiveKit (public connection URL only; token fetched from the backend) ---
# Also requires a custom dev build (@livekit/react-native native module). In
# Expo Go the app falls back to the expo-video looping player.
EXPO_PUBLIC_LIVEKIT_URL=

# --- public web/legal URL and Monad testnet RPC ---
EXPO_PUBLIC_WEB_URL=https://ennoia.app
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# --- Envio (optional; backend proxies it — normally blank) ---
EXPO_PUBLIC_ENVIO_GRAPHQL_URL=
