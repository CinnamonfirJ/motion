# ==================================================================
# ENNOIA — WEB environment (copy to apps/web/.env)
#
# Vite inlines every VITE_-prefixed var into the CLIENT BUNDLE. Only put
# PUBLIC, non-secret values here. Never add an API secret, app secret, or
# private key — those belong in apps/server/.env only.
# ==================================================================

# Backend REST + WebSocket (the server proxies all secrets/onchain calls).
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# --- Mera (passkey-derived accounts; no keys or app IDs needed) ---
# "fallback" switches to the local-only email + native WebAuthn demo.
VITE_AUTH_MODE=mera
# Passkey relying party. Defaults to the page's hostname. Every surface that must
# reach the same account needs the same RP ID (e.g. ennoia.live, not www.ennoia.live).
# VITE_PASSKEY_RP_ID=
# Optional: pin the only contract that may be signed for without a passkey prompt
# (tips). Blank = taken from the backend's /config.
# VITE_MOMENT_REWARDS_ADDRESS=

# --- Monad RPC the browser sends signed transactions to ---
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_MONAD_CHAIN_ID=10143
