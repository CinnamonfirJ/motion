# ==================================================================
# ENNOIA — WEB environment (copy to apps/web/.env)
#
# Vite inlines every VITE_-prefixed var into the CLIENT BUNDLE. Only put
# PUBLIC, non-secret values here. Never add an API secret, app secret, or
# private key — those belong in apps/server/.env only.
# ==================================================================

# Backend REST + WebSocket (the server proxies all secrets/onchain calls).
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# --- Privy (public app identifiers only) ---
# App ID + optional client ID from the Privy dashboard. Blank = fallback auth
# (email + native WebAuthn passkeys) served by the backend.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

# --- LiveKit (public connection URL only; token is fetched from the backend) ---
# wss:// host. Blank = fake-live (looping VOD) player fallback.
VITE_LIVEKIT_URL=

# --- Monad (public chain id, for explorer links / display) ---
VITE_MONAD_CHAIN_ID=10143
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# --- Envio (optional; direct reads of PUBLIC analytics only) ---
# Normally left blank — the backend proxies Envio so the client needs no endpoint.
VITE_ENVIO_GRAPHQL_URL=
