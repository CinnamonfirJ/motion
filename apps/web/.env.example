# ==================================================================
# ENNOIA — WEB environment (copy to apps/web/.env)
#
# Vite inlines every VITE_-prefixed var into the CLIENT BUNDLE. Only put
# PUBLIC, non-secret values here. Never add an API secret, app secret, or
# private key — those belong in apps/server/.env only.
# ==================================================================

# Backend REST + WebSocket (the server proxies all secrets/onchain calls).
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# --- Privy (public app identifiers only) ---
# App ID from the Privy dashboard. Blank = fallback auth
# (email + native WebAuthn passkeys) served by the backend.
VITE_PRIVY_APP_ID=
# Optional VITE_PRIVY_CLIENT_ID can be added if your Privy app uses one.

# --- Monad RPC used by the Privy client ---
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
