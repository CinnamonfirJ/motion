# ==================================================================
# ENNOIA — SERVER environment (copy to apps/server/.env or repo-root .env)
#
# EVERYTHING HERE IS SERVER-ONLY. Never copy a value from this file into
# apps/web or apps/mobile. Client-safe values live in those apps' own
# .env.example files (VITE_ / EXPO_PUBLIC_ prefixed).
# ==================================================================

# --- core ---
APP_MODE=development
PORT=4000
HOST=0.0.0.0
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Signs the convenience app session token minted after Mera (or fallback) sign-in.
JWT_SECRET=change-me-in-production
# Neon PostgreSQL. Required when APP_MODE=production.
DATABASE_URL=
# Development-only SQLite fallback (defaults to apps/server/data/moment.sqlite).
# DB_PATH=

# --- Accounts: Mera (passkey-derived Monad EOAs; no third-party keys) ---
# "mera" (default, required in production) or "fallback" (local email/WebAuthn demo).
AUTH_PROVIDER=mera
# Testnet MON sent to each NEW Mera account so its first transaction needs no faucet.
# 0 disables. Only runs on chain 10143.
ONBOARD_DRIP_WEI=30000000000000000
# Funds the drip. Blank = SETTLER_PRIVATE_KEY; a separate funded key is recommended so
# drips never contend with settlement transactions for nonces.
FAUCET_PRIVATE_KEY=
# Comma-separated Mera account addresses permitted to use moderation/admin routes.
ADMIN_ADDRESSES=

# --- Privy (legacy: only for clients not yet on Mera, i.e. mobile) ---
# Leave blank to disable POST /auth/privy.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional PRIVY_VERIFICATION_KEY can be added for offline JWT verification.

# --- LiveKit (livestream A/V; SERVER MINTS TOKENS) ---
# LIVEKIT_URL is the wss:// host clients connect to; the API key/secret NEVER leave
# the server. Leave LIVEKIT_URL blank to run the fake-live (looping VOD) fallback.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LiveKit Egress writes HLS segments to Cloudflare R2. Required in production.
LIVEKIT_EGRESS_REGION=auto

# --- Cloudflare R2 (permanent stream segments and Moment manifests) ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public custom domain (or public R2.dev URL), without a trailing slash.
R2_PUBLIC_BASE_URL=

# --- Monad (onchain rewards/social; leave blank for local SIMULATION) ---
MONAD_RPC_URL=
MONAD_CHAIN_ID=10143
MOMENT_REWARDS_ADDRESS=
# Backend signer that submits commit/create/settle transactions. Fund it with MON.
SETTLER_PRIVATE_KEY=
# Platform recipient of the 10% reward cut (defaults to the settler when blank).
PLATFORM_ADDRESS=
MONAD_EXPLORER_TX=https://testnet.monadexplorer.com/tx/

# --- Envio (Monad indexer; read-only analytics source) ---
# GraphQL endpoint of your running Envio HyperIndex (packages/indexer). When blank,
# feeds/leaderboards/earnings fall back to database aggregates in development.
ENVIO_GRAPHQL_URL=

# --- fallback auth (used ONLY when AUTH_PROVIDER=fallback) ---
# Deterministically derives each fallback user's embedded wallet. Use a real secret
# mnemonic in shared/production environments. Default = well-known hardhat phrase.
WALLET_MASTER_MNEMONIC="test test test test test test test test test test test junk"
# Native WebAuthn relying party (fallback passkeys). RP_ID must be a registrable
# domain of the web origin — use "localhost" for local dev (not a raw LAN IP).
RP_ID=localhost
RP_NAME=ENNOIA
# Comma-separated allowed web origins; blank = allow localhost origins in dev.
RP_ORIGINS=

# --- display / demo ---
# Render integer token units as USD in the UI (display only; never affects on-chain amounts).
UNITS_PER_USD=2000000000000000
# Seed demo streams + bot participants that drive reliable spikes (false for a clean DB).
ENABLE_SEED=true
ENABLE_DEMO_ROUTES=true
# Comma-separated Privy user IDs permitted to use moderation/admin routes.
# Optional ADMIN_PRIVY_IDS can grant specific Privy users moderation access.
# Minimum unique Scouts for a Moment to be detected + confirmed (all modes, default 2).
# 1 lets a solo demo trigger a real Moment; raise it for larger audiences.
MOMENT_MIN_REACTORS=2
