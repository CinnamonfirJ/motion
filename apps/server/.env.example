# ==================================================================
# ENNOIA — SERVER environment (copy to apps/server/.env or repo-root .env)
#
# EVERYTHING HERE IS SERVER-ONLY. Never copy a value from this file into
# apps/web or apps/mobile. Client-safe values live in those apps' own
# .env.example files (VITE_ / EXPO_PUBLIC_ prefixed).
# ==================================================================

# --- core ---
PORT=4000
HOST=0.0.0.0
# Signs the short-lived app session token minted after Privy (or fallback) auth.
JWT_SECRET=change-me-in-production
# SQLite file path (defaults to apps/server/data/moment.sqlite)
# DB_PATH=

# --- Privy (auth + embedded wallet; SOURCE OF TRUTH when set) ---
# From the Privy dashboard (https://dashboard.privy.io). Leave PRIVY_APP_ID blank
# to run the built-in fallback auth (email + native WebAuthn passkeys).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Privy "Verification Key" (public key, PEM) used to verify access-token signatures
# offline. Optional but recommended; without it the SDK verifies via Privy's API.
PRIVY_VERIFICATION_KEY=

# --- LiveKit (livestream A/V; SERVER MINTS TOKENS) ---
# LIVEKIT_URL is the wss:// host clients connect to; the API key/secret NEVER leave
# the server. Leave LIVEKIT_URL blank to run the fake-live (looping VOD) fallback.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional LiveKit Egress → object storage, required for REAL clips of live rooms.
# When unset, clips use the media-fragment path over the source/VOD video.
LIVEKIT_EGRESS_BUCKET=
LIVEKIT_EGRESS_REGION=

# --- Monad (onchain rewards/social; leave blank for local SIMULATION) ---
MONAD_RPC_URL=
MONAD_CHAIN_ID=10143
MOMENT_REWARDS_ADDRESS=
# Backend signer that submits commit/create/settle transactions. Fund it with MON.
SETTLER_PRIVATE_KEY=
# Platform recipient of the 10% reward cut (defaults to the settler when blank).
PLATFORM_ADDRESS=
MONAD_EXPLORER_TX=https://testnet.monadexplorer.com/tx/

# --- Envio (Monad indexer; read-only analytics source) ---
# GraphQL endpoint of your running Envio HyperIndex (packages/indexer). When blank,
# feeds/leaderboards/earnings fall back to the local SQLite aggregates.
ENVIO_GRAPHQL_URL=

# --- fallback auth (used ONLY when PRIVY_APP_ID is blank) ---
# Deterministically derives each fallback user's embedded wallet. Use a real secret
# mnemonic in shared/production environments. Default = well-known hardhat phrase.
WALLET_MASTER_MNEMONIC="test test test test test test test test test test test junk"
# Native WebAuthn relying party (fallback passkeys). RP_ID must be a registrable
# domain of the web origin — use "localhost" for local dev (not a raw LAN IP).
RP_ID=localhost
RP_NAME=ENNOIA
# Comma-separated allowed web origins; blank = allow localhost origins in dev.
RP_ORIGINS=

# --- display / demo ---
# Render integer token units as USD in the UI (display only; never affects on-chain amounts).
UNITS_PER_USD=2000000000000000
# Seed demo streams + bot participants that drive reliable spikes (false for a clean DB).
ENABLE_SEED=true
