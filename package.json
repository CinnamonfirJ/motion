{
  "name": "ennoia",
  "private": true,
  "version": "0.1.0",
  "description": "ENNOIA — spot the livestream moment before everyone else. Cross-platform (web + iOS + Android) reaction-curation product settled on Monad.",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:core": "pnpm --filter @ennoia/core build",
    "test": "pnpm --filter @ennoia/core test run",
    "test:core": "pnpm --filter @ennoia/core test run",
    "test:contracts": "pnpm --filter @ennoia/contracts test",
    "dev:server": "pnpm --filter @ennoia/server dev",
    "dev:web": "pnpm --filter @ennoia/web dev",
    "dev:mobile": "pnpm --filter @ennoia/mobile start",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
