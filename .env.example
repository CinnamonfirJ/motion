# ==================================================================
# ENNOIA — environment overview
#
# Each app has its OWN .env.example with the full, annotated list:
#   • apps/server/.env.example   — ALL server secrets (Privy/LiveKit/Monad/Envio)
#   • apps/web/.env.example      — public VITE_ vars only
#   • apps/mobile/.env.example   — public EXPO_PUBLIC_ vars only
#   • packages/contracts         — DEPLOYER_PRIVATE_KEY etc. (see below)
#
# The server also reads a repo-root .env (this file, copied to .env), so for
# local dev you can keep all SERVER values here. NEVER put secrets in the web
# or mobile env — those bundles ship to users.
#
# Architecture:  Privy (passkey auth + wallet) · LiveKit (A/V) ·
#                Monad (rewards/social onchain) · Envio (indexes Monad)
# APP_MODE=development permits local fallbacks. APP_MODE=production fails startup
# unless every real integration is configured.
# ==================================================================

# ---- server core ----
APP_MODE=development
PORT=4000
HOST=0.0.0.0
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-in-production
DATABASE_URL=

# ---- Privy (blank => email + native WebAuthn fallback) ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# ---- LiveKit (blank => fake-live VOD fallback) ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Cloudflare R2 (LiveKit Egress + permanent Moment clips) ----
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
LIVEKIT_EGRESS_REGION=auto

# ---- Monad (blank => local settlement simulation) ----
MONAD_RPC_URL=
MONAD_CHAIN_ID=10143
MOMENT_REWARDS_ADDRESS=
SETTLER_PRIVATE_KEY=
PLATFORM_ADDRESS=
MONAD_EXPLORER_TX=https://testnet.monadexplorer.com/tx/

# ---- Envio (blank => database aggregates in development) ----
ENVIO_GRAPHQL_URL=

# ---- fallback auth (used only when PRIVY_APP_ID is blank) ----
WALLET_MASTER_MNEMONIC="test test test test test test test test test test test junk"
RP_ID=localhost
RP_NAME=ENNOIA
RP_ORIGINS=

# ---- display / demo ----
UNITS_PER_USD=2000000000000000
ENABLE_SEED=true
ENABLE_DEMO_ROUTES=true
ADMIN_PRIVY_IDS=

# ---- contracts (packages/contracts) deploy/fund ----
DEPLOYER_PRIVATE_KEY=
SETTLER_ADDRESS=
FUND_AMOUNT_ETHER=0.5

# ---- client public vars (mirror into apps/web/.env & apps/mobile/.env) ----
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
VITE_PRIVY_APP_ID=
VITE_LIVEKIT_URL=
VITE_MONAD_CHAIN_ID=10143
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WS_URL=ws://localhost:4000/ws
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_LIVEKIT_URL=
EXPO_PUBLIC_PRIVY_RELYING_PARTY=https://ennoia.app
EXPO_PUBLIC_WEB_URL=https://ennoia.app
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
