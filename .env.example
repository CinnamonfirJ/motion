# ==================================================================
# ENNOIA — local backend environment (copy to repo-root .env)
#
# Each app has its OWN .env.example with the full, annotated list:
#   • apps/server/.env.example   — ALL server secrets (Privy/LiveKit/Monad/Envio)
#   • apps/web/.env.example      — public VITE_ vars only
#   • apps/mobile/.env.example   — public EXPO_PUBLIC_ vars only
#   • packages/contracts         — deployment keys, used only by Hardhat
#
# The server reads repo-root .env for local development. This tracked example
# deliberately leaves credentials blank; never commit real secrets. Web/mobile
# values belong in their own app env files and are included in client bundles.
#
# Architecture:  Privy (passkey auth + wallet) · LiveKit (A/V) ·
#                Monad (rewards/social onchain) · Envio (indexes Monad)
# APP_MODE=development permits local fallbacks. APP_MODE=production fails startup
# unless every real integration is configured.
# ==================================================================

# ---- server core ----
APP_MODE=development
PORT=4000
HOST=0.0.0.0
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-in-production
DATABASE_URL=

# ---- Privy (blank => email + native WebAuthn fallback) ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---- LiveKit (blank => fake-live VOD fallback) ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Cloudflare R2 (LiveKit Egress + permanent Moment clips) ----
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
LIVEKIT_EGRESS_REGION=auto

# ---- Monad (blank => local settlement simulation) ----
MONAD_RPC_URL=
MONAD_CHAIN_ID=10143
MOMENT_REWARDS_ADDRESS=
SETTLER_PRIVATE_KEY=
PLATFORM_ADDRESS=
MONAD_EXPLORER_TX=https://testnet.monadexplorer.com/tx/

# ---- Envio (blank => database aggregates in development) ----
ENVIO_GRAPHQL_URL=

# ---- fallback auth (used only when PRIVY_APP_ID is blank) ----
# The server supplies a development-only mnemonic by default; set your own
# secret if using fallback auth outside local development.
RP_ID=localhost
RP_NAME=ENNOIA
RP_ORIGINS=

# ---- display / demo ----
UNITS_PER_USD=2000000000000000
ENABLE_SEED=true
ENABLE_DEMO_ROUTES=true
