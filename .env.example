# ------------------------------------------------------------------
# Moment — environment configuration (copy to .env; never commit .env)
# ------------------------------------------------------------------

# --- backend ---
PORT=4000
HOST=0.0.0.0
JWT_SECRET=change-me-in-production
# SQLite file path (defaults to apps/server/data/moment.sqlite)
# DB_PATH=

# Deterministically derives each user's embedded wallet. Use a real, secret mnemonic
# in any shared/production environment. The default is the well-known hardhat test phrase.
WALLET_MASTER_MNEMONIC="test test test test test test test test test test test junk"

# Render integer token units as USD in the UI. 1e18 units = $1 by default.
UNITS_PER_USD=1000000000000000000

# Seed demo streams + bot participants that drive reliable spikes (set false for a clean DB).
ENABLE_SEED=true

# --- Passkey (WebAuthn) sign-in ---
# RP_ID must be a registrable domain of the web origin. Use "localhost" for local dev
# (passkeys do NOT work over a raw LAN IP). In production set it to your domain.
RP_ID=localhost
RP_NAME=Moment
# Comma-separated allowed web origins; leave blank to allow localhost origins in dev.
RP_ORIGINS=

# --- Monad settlement (leave blank to run local settlement SIMULATION) ---
# Provide all three to enable REAL, idempotent on-chain settlement.
MONAD_RPC_URL=
MOMENT_REWARDS_ADDRESS=
SETTLER_PRIVATE_KEY=
# Platform recipient of the 10% reward cut (defaults to the settler address when blank).
PLATFORM_ADDRESS=
MONAD_EXPLORER_TX=https://testnet.monadexplorer.com/tx/

# --- contracts (packages/contracts) deploy/fund ---
DEPLOYER_PRIVATE_KEY=
# Extra settler to authorize (usually the backend SETTLER address). Optional.
SETTLER_ADDRESS=
# Initial reward pool funding in MON when deploying.
FUND_AMOUNT_ETHER=0.5

# --- web (apps/web, Vite — must be prefixed VITE_) ---
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# --- mobile (apps/mobile, Expo — must be prefixed EXPO_PUBLIC_) ---
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WS_URL=ws://localhost:4000/ws
